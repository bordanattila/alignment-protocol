# Server-only reference. No automatic .env loading; export chosen values explicitly.
# Milestone 9.2 reads these at backend startup. Authored missions remain default.
# Enabled and fully configured servers offer an explicit generated mission mode.
CONSENSUS_LLM_ENABLED=false
# Full chat-completions endpoint and model: supply operator-selected values.
CONSENSUS_LLM_ENDPOINT=
CONSENSUS_LLM_MODEL=
CONSENSUS_LLM_API_KEY=
CONSENSUS_LLM_REQUIRE_API_KEY=true
CONSENSUS_LLM_TIMEOUT_SECONDS=15
# Use json_object explicitly for endpoints without strict json_schema support.
# Both formats receive the same backend validation.
CONSENSUS_LLM_RESPONSE_FORMAT=json_schema
# Local loopback HTTP servers may use REQUIRE_API_KEY=false with an empty key.
# Remote endpoints require HTTPS. Never use VITE_ variables for provider secrets.
