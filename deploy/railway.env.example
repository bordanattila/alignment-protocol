# Reference only: configure through Railway's private Variables UI after approval.
# Attach a Railway volume at /data first; startup rejects an ordinary directory.
CONSENSUS_DB_PATH=/data/consensus-engine.sqlite3
CONSENSUS_LLM_ENABLED=false
# Exact owner-private Sites origin, no trailing slash; required before startup.
CONSENSUS_SITE_ORIGIN=
# Random server-only secret (32+ characters), shared with Sites runtime settings.
# Never set a VITE_ variable or paste the key into chat or source control.
CONSENSUS_GATEWAY_KEY=
