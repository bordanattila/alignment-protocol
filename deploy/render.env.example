# Set privately after provisioning approval. No provider API key is needed.
CONSENSUS_DB_PATH=/data/consensus-engine.sqlite3
CONSENSUS_LLM_ENABLED=false
# Exact owner-private Sites HTTPS origin with no trailing slash.
CONSENSUS_SITE_ORIGIN=
# Same strong random server-only secret in Sites and Render; never use VITE_.
CONSENSUS_GATEWAY_KEY=
# Leave RAILWAY_VOLUME_MOUNT_PATH unset: existing factory defaults to /data.
# Render supplies PORT. Keep the Docker CMD and its single worker unchanged.
